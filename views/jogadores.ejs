<%- include('partials/header') %>
<%- include('partials/navbar') %>


<div class="container cadastro-container">
    <div class="card cadastro-card">

        <div class="card-header cadastro-header">
            <h1>
                <i class="bi bi-person-badge-fill"></i>
                Cadastrar Jogador
            </h1>
            <p>Adicione um novo jogador ao catálogo de futebol.</p>
        </div>

        <div class="card-body">
            <form action="/jogadores/cadastrar" method="POST">

                <div class="mb-3">
                    <label for="nome" class="form-label">
                        Nome do jogador
                    </label>

                    <input
                        type="text"
                        id="nome"
                        name="nome"
                        placeholder="Ex.: Neymar Jr."
                        class="form-control"
                        required>
                </div>

                <div class="mb-3">
                    <label for="clube" class="form-label">
                        Clube do jogador
                    </label>

                    <input
                        type="text"
                        id="clube"
                        name="clube"
                        placeholder="Ex.: Santos FC"
                        class="form-control"
                        required>
                </div>

                <div class="mb-3">
                    <label for="posicao" class="form-label">
                        Posição do jogador
                    </label>

                    <input
                        type="text"
                        id="posicao"
                        name="posicao"
                        placeholder="Ex.: Atacante"
                        class="form-control"
                        required>
                </div>

                <div class="mb-3">
                    <label for="nacionalidade" class="form-label">
                        Nacionalidade
                    </label>

                    <input
                        type="text"
                        id="nacionalidade"
                        name="nacionalidade"
                        placeholder="Ex.: Brasileiro"
                        class="form-control"
                        required>
                </div>

                <div class="mb-4">
                    <label for="imagem" class="form-label">
                        URL da foto do jogador
                    </label>

                    <input
                        type="text"
                        id="imagem"
                        name="imagem"
                        placeholder="Cole o link da foto do jogador"
                        class="form-control"
                        required>

                    <small class="form-text text-muted">
                        Informe o endereço da imagem do jogador.
                    </small>
                </div>

                <hr>

                <div class="cadastro-acoes">
                    <button type="reset" class="btn btn-limpar">
                        <i class="bi bi-eraser"></i>
                        Limpar
                    </button>

                    <button type="submit" class="btn btn-cadastrar">
                        <i class="bi bi-person-plus-fill"></i>
                        Cadastrar jogador
                    </button>
                </div>

            </form>
        </div>

    </div>
</div>


<div class="container mt-5">

  <h1 class="text-center mb-4">Jogadores</h1>

  <div class="row">
    
    <% jogadores.forEach(jogador => { %>
      
      <div class="col-md-4">
        <div class="card shadow mb-4">
          
          <img src="<%= jogador.imagem %>" class="card-img-top p-3" alt="<%= jogador.nome %>" style="height: 250px; object-fit: contain;">

          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h5 class="card-title mb-0 fw-bold"><%= jogador.nome %></h5>
              <span class="badge bg-dark fs-6">#<%= jogador.numero %></span>
            </div>

            <p class="card-text">
              <strong>Clube:</strong> <%= jogador.clube %><br>
              <strong>Posição:</strong> <%= jogador.posicao %><br>
              <strong>Nacionalidade:</strong> <%= jogador.nacionalidade %>
            </p>
          </div>

            <!-- Botões de ação adicionados ao card -->
                    <div class="card-footer d-flex justify-content-between">
                        <a class="btn btn-warning" href="/jogadores/editar/<%= jogador.id %>">Editar</a>
                        <a class="btn btn-danger" href="/jogadores/excluir/<%= jogador.id %>" 
                           onclick="return confirm('Deseja mesmo excluir o jogador <%= jogador.nome %>?')">Excluir</a>
                    </div>

        </div>
      </div>

    <% }) %>

  </div>
</div>

<%- include('partials/footer') %>