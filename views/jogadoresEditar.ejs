<%- include('partials/header.ejs')%>
<%- include('partials/navbar.ejs')%>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h1>Editar Jogador</h1>
            <br>
        </div>
        <div class="card-body">
            <form action="/jogadores/alterar" method="post">
                <label for="nome">Nome do Jogador</label>
            <input type="text" name="nome" id="nome" class="form-control" required value="<%=jogador.nome %>">
            <label for="clube">Clube do Jogador</label>
            <input type="text" name="clube" id="clube" class="form-control" required value="<%=jogador.clube %>">
            <label for="posicao">Posição do Jogador</label>
            <input type="text" name="posicao" id="posicao" class="form-control" required value="<%=jogador.posicao %>">
            <label for="nacionalidade">Nacionalidade do jogador</label>
            <input type="text" name="nacionalidade" id="nacionalidade" class="form-control" required value="<%= jogador.nacionalidade %>">
            <label for="imagem">Imagem do jogador</label>
            <input type="text" name="imagem" id="imagem" class="form-control" required value="<%= jogador.imagem %>">
            <!-- Campo invisível com a ID do jogador -->
             <input type="hidden" name="id" id="id" value="<%=jogador.id %>">
            <br>
            <button type="submit" class="btn btn-warning" onclick="return confirm('Deseja mesmo alterar o jogador <%=jogador.nome %>')">Alterar</button>
            <a href="/jogadores">
            <button type="button" class="btn btn-danger">Cancelar</button>
            </a>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer.ejs')%>