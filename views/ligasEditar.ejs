<%- include('partials/header.ejs')%>
<%- include('partials/navbar.ejs')%>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h1>Editar Clube</h1>
            <br>
        </div>
        <div class="card-body">
            <form action="/ligas/alterar" method="post">
                <label for="nome">Nome da liga</label>
            <input type="text" name="nome" id="nome" class="form-control" required value="<%=liga.nome %>">
            <label for="pais">País da liga</label>
            <input type="text" name="pais" id="pais" class="form-control" required value="<%=liga.pais %>">
            <label for="maiorCampeao">Maior campeão da liga</label>
            <input type="text" name="maiorCampeao" id="maiorCampeao" class="form-control" required value="<%= liga.maiorCampeao %>">
            <label for="imagem">Logo da liga</label>
            <input type="text" name="imagem" id="imagem" class="form-control" required value="<%= liga.imagem %>">
            <!-- Campo invisível com a ID da liga -->
             <input type="hidden" name="id" id="id" value="<%=liga.id %>">
            <br>
            <button type="submit" class="btn btn-warning" onclick="return confirm('Deseja mesmo alterar a liga <%=liga.nome %>')">Alterar</button>
            <a href="/ligas">
            <button type="button" class="btn btn-danger">Cancelar</button>
            </a>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer.ejs')%>